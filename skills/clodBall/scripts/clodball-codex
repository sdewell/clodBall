#!/bin/sh
# Queue one check after the packaged watcher wakes (new entry or stall suspected); the completed check re-arms.
# Usage: clodball-codex <thread-uuid> <absolute-handoff> <saved-cursor> <absolute-state-dir>
#        clodball-codex ack <started|handled> <absolute-run-dir>
# The caller owns the state directory and prevents overlapping launches.
# CLODBALL_ACK_TIMEOUT sets the start acknowledgement timeout in seconds (default 300).
# A timeout records an alert; it never queues again or changes queue success to failure.
# Exit 2 means invalid arguments or an unverified receipt; child failures retain their status.
set -eu

die() {
  echo "clodball-codex: $*" >&2
  exit 2
}

is_uuid() {
  case "$1" in ''|*[!0-9a-fA-F-]*) return 1 ;; esac
  LC_ALL=C grep -Eq '^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$' <<EOF
$1
EOF
}

shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

if [ "${1:-}" = ack ]; then
  [ "$#" -eq 3 ] || die 'supply ack, started or handled, and an absolute run directory'
  acknowledgement=$2
  run_dir=$3
  case "$acknowledgement" in started|handled) ;; *) die 'acknowledgement must be started or handled' ;; esac
  case "$run_dir" in /*) ;; *) die 'run directory must be absolute' ;; esac
  [ -r "$run_dir/run-path.txt" ] || die 'unknown launch run'
  IFS= read -r recorded_run < "$run_dir/run-path.txt" || die 'unreadable launch identity'
  [ "$recorded_run" = "$run_dir" ] || die 'run directory does not match its recorded identity'
  [ -s "$run_dir/queue-requested-at.txt" ] || die 'launch has not attempted to queue a check'
  if [ "$acknowledgement" = handled ]; then
    [ -s "$run_dir/started-at.txt" ] || die 'record started before handled'
  fi
  target="$run_dir/$acknowledgement-at.txt"
  if [ ! -s "$target" ]; then
    stamp=$(mktemp "$run_dir/ack.XXXXXXXX")
    date -u +%Y-%m-%dT%H:%M:%SZ > "$stamp"
    # Linking publishes a complete first receipt without replacing an earlier one.
    if ! ln "$stamp" "$target" 2>/dev/null; then
      rm -f "$stamp"
      [ -s "$target" ] || die 'could not record acknowledgement'
    else
      rm -f "$stamp"
    fi
  fi
  exit 0
fi

[ "$#" -eq 4 ] || die 'supply thread UUID, absolute handoff path, saved cursor, and absolute state directory'
thread=$1
handoff=$2
cursor=$3
state_dir=$4
case "$state_dir" in /*) ;; *) die 'state directory must be absolute' ;; esac
mkdir -p "$state_dir/runs"
run_dir=$(mktemp -d "$state_dir/runs/run.XXXXXXXX")
date -u +%Y-%m-%dT%H:%M:%SZ > "$run_dir/created-at.txt"
printf '%s\n' "$run_dir" > "$run_dir/run-path.txt"
printf '%s\n' "$run_dir" > "$state_dir/current-run.txt"
# These paths remain the latest-launch view; the run itself is never reused.
for file in phase.txt wake.out wake.err queue.out queue.err expected-wake.txt expected-queue.txt; do
  rm -f "$state_dir/$file"
  ln -s "$run_dir/$file" "$state_dir/$file"
done
state_dir=$run_dir
: > "$state_dir/wake.out"
: > "$state_dir/wake.err"
: > "$state_dir/queue.out"
: > "$state_dir/queue.err"
rm -f "$state_dir/expected-wake.txt" "$state_dir/expected-queue.txt"
printf '%s\n' invalid-arguments > "$state_dir/phase.txt"
is_uuid "$thread" || die 'thread must be a UUID'
thread=$(printf '%s' "$thread" | tr '[:upper:]' '[:lower:]')
case "$handoff" in /*) ;; *) die 'handoff path must be absolute' ;; esac
case "$cursor" in ''|*[!0-9]*) die 'saved cursor must be a nonnegative integer' ;; esac
ack_timeout=${CLODBALL_ACK_TIMEOUT:-300}
case "$ack_timeout" in ''|*[!0-9]*) die 'acknowledgement timeout must be a nonnegative integer' ;; esac
scripts=$(cd -- "$(dirname -- "$0")" && pwd -P)
printf '%s\n' watching > "$state_dir/phase.txt"
if "$scripts/clodball-watch" cx "$handoff" "$cursor" > "$state_dir/wake.out" 2> "$state_dir/wake.err"; then
  :
else
  result=$?
  printf '%s\n' watcher-failed > "$state_dir/phase.txt"
  echo "clodball-codex: watcher failed; see $state_dir/wake.err" >&2
  exit "$result"
fi
printf 'clodball: new entry for cx in %s\n' "$handoff" > "$state_dir/expected-wake.txt"
check_kind='new entry'
if ! cmp -s "$state_dir/expected-wake.txt" "$state_dir/wake.out"; then
  # The watcher names its limit on the stall line; carry it into the message
  # so the delayed check re-tests the limit that fired.
  IFS= read -r wake_line < "$state_dir/wake.out" || wake_line=
  stall_minutes=${wake_line##*"(limit "}
  stall_minutes=${stall_minutes%" minutes)"}
  case "$stall_minutes" in ''|*[!0-9]*) stall_minutes=0 ;; esac
  printf 'clodball: stall suspected for cx in %s (limit %s minutes)\n' "$handoff" "$stall_minutes" > "$state_dir/expected-wake.txt"
  if ! cmp -s "$state_dir/expected-wake.txt" "$state_dir/wake.out"; then
    printf '%s\n' invalid-wake-output > "$state_dir/phase.txt"
    echo "clodball-codex: unexpected watcher output; see $state_dir/wake.out" >&2
    exit 2
  fi
  check_kind="stall suspected (limit $stall_minutes minutes)"
fi
printf '%s\n' queuing > "$state_dir/phase.txt"
date -u +%Y-%m-%dT%H:%M:%SZ > "$state_dir/queue-requested-at.txt"
quoted_launcher=$(shell_quote "$scripts/clodball-codex")
quoted_run=$(shell_quote "$run_dir")
message="\$clodBall check: $check_kind in $handoff
Before reading the snapshot, run: $quoted_launcher ack started $quoted_run
After successfully handling the snapshot and saving its cursor, before re-arming, run: $quoted_launcher ack handled $quoted_run"
if codex queue --thread "$thread" --message "$message" > "$state_dir/queue.out" 2> "$state_dir/queue.err"; then
  :
else
  result=$?
  printf '%s\n' queue-failed > "$state_dir/phase.txt"
  echo "clodball-codex: queue failed; see $state_dir/queue.err" >&2
  exit "$result"
fi
queue_valid=0
if IFS= read -r receipt < "$state_dir/queue.out"; then
  message_id=${receipt#'Queued message '}
  message_id=${message_id%" for thread $thread."}
  if is_uuid "$message_id"; then
    printf 'Queued message %s for thread %s.\n' "$message_id" "$thread" > "$state_dir/expected-queue.txt"
    if cmp -s "$state_dir/expected-queue.txt" "$state_dir/queue.out"; then
      queue_valid=1
    fi
  fi
fi
if [ "$queue_valid" -ne 1 ]; then
  printf '%s\n' queue-outcome-uncertain > "$state_dir/phase.txt"
  echo "clodball-codex: queue confirmation is uncertain; inspect $state_dir/queue.out before retrying" >&2
  exit 2
fi
printf '%s\n' queued > "$state_dir/phase.txt"
date -u +%Y-%m-%dT%H:%M:%SZ > "$state_dir/queued-at.txt"
deadline=$(($(date +%s) + ack_timeout))
while [ ! -s "$state_dir/started-at.txt" ]; do
  remaining=$((deadline - $(date +%s)))
  if [ "$remaining" -le 0 ]; then
    # Re-read at the deadline: an acknowledgement may have arrived during the poll.
    [ ! -s "$state_dir/started-at.txt" ] || break
    printf '%s no started acknowledgement observed within %s seconds; the thread may still be busy\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ack_timeout" > "$state_dir/alert.txt"
    printf 'clodball-codex: %s; see %s\n' "$(cat "$state_dir/alert.txt")" "$state_dir" >&2
    break
  fi
  [ "$remaining" -le 30 ] || remaining=30
  sleep "$remaining"
done
